{
  "name": "casafro-gestao",
  "version": "1.0.0",
  "private": true,
  "description": "CasAfro Gestão — estoque, vendas, consignações, comissões e relatórios",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts --se-configurado && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "criar-admin": "tsx scripts/criar-admin.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.28",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.13",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
