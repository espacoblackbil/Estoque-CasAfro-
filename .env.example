# PostgreSQL persistente (ex.: Neon/Supabase). Sem esta variável, o app usa PGlite local em ./.data (apenas desenvolvimento).
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Token exigido na tela /setup para criar o administrador principal (só funciona enquanto não houver usuários).
SETUP_TOKEN=troque-por-um-valor-longo-e-aleatorio
